# Copy to .env before `docker compose up`. Do not commit the filled-in file.
# An existing MongoDB volume created without a root user will not pick up
# MONGO_INITDB_* on the next start. Recreate that volume once after enabling auth.

MONGO_USERNAME=codehealer
MONGO_PASSWORD=replace-with-a-mongo-password
JWT_SECRET=replace-with-a-long-random-string
APP_ENCRYPTION_KEY=replace-with-another-long-random-string
JOB_RUNNER_SHARED_SECRET=replace-with-a-shared-random-string
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-an-admin-password
